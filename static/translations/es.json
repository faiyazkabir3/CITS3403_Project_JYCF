  "patterns": [
    { "pattern": "^LEVEL (\\d+)$", "replacement": "NIVEL $1" },
    { "pattern": "^LEVEL (\\d+) - (.+)$", "replacement": "NIVEL $1 - $2" },
    { "pattern": "^Chat with (.+)$", "replacement": "Chat con $1" },
    { "pattern": "^CHARACTER: (.+)$", "replacement": "PERSONAJE: $1" },
    { "pattern": "^DIFFICULTY: (.+)$", "replacement": "DIFICULTAD: $1" },
    { "pattern": "^HEALTH: (.+)$", "replacement": "SALUD: $1" },
    { "pattern": "^AMMO: (.+)$", "replacement": "MUNICIÓN: $1" },
    { "pattern": "^COINS: (.+)$", "replacement": "MONEDAS: $1" },
    { "pattern": "^HP (.+) \\| HOSTILE$", "replacement": "PV $1 | HOSTIL" },
    { "pattern": "^HP (.+) \\| RAGING$", "replacement": "PV $1 | FURIOSO" },
    { "pattern": "^HP (.+) \\| CHARGING$", "replacement": "PV $1 | CARGANDO" },
    { "pattern": "^HP (.+) \\| STUNNED (\\d+)$", "replacement": "PV $1 | ATURDIDO $2" },
    { "pattern": "^STUNNED (\\d+)$", "replacement": "ATURDIDO $1" },
    { "pattern": "^POISON (\\d+)$", "replacement": "VENENO $1" },
    { "pattern": "^CORROSION (\\d+)$", "replacement": "CORROSIÓN $1" },
    { "pattern": "^STEP (\\d+)/(\\d+) \\| (\\d+)/(\\d+)$", "replacement": "PASO $1/$2 | $3/$4" },
    { "pattern": "^Total pistol ammo with you: (.+)$", "replacement": "Munición total de pistola contigo: $1" },
    { "pattern": "^Total rifle ammo with you: (.+)$", "replacement": "Munición total de rifle contigo: $1" },
    { "pattern": "^Grenades with you: (.+)$", "replacement": "Granadas contigo: $1" },
    { "pattern": "^Medkits with you: (.+)$", "replacement": "Botiquines contigo: $1" },
    { "pattern": "^(.+) damage$", "replacement": "$1 de daño" },
    { "pattern": "^(.+) HP$", "replacement": "$1 PV" },
    { "pattern": "^(.+) coins$", "replacement": "$1 monedas" },
    { "pattern": "^You gained (.+)$", "replacement": "Has ganado $1" },
    { "pattern": "^You found (.+)$", "replacement": "Has encontrado $1" },
    { "pattern": "^(.+) attacks!$", "replacement": "¡$1 ataca!" },
    { "pattern": "^(.+) defeated.$", "replacement": "$1 derrotado." },
    { "pattern": "^(.+) is defeated.$", "replacement": "$1 ha sido derrotado." },
    { "pattern": "^(.+) used a medkit.$", "replacement": "$1 usó un botiquín." },
    { "pattern": "^Reloaded (.+).$", "replacement": "$1 recargado." }
  ]
}
