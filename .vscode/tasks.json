{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Flask app",
      "type": "shell",
      "command": "python app.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint JS",
      "type": "shell",
      "command": "npm run lint:js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
